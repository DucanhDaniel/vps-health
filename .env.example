# ===== Bắt buộc =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# ===== Tùy chọn =====
PORT=3100
SERVER_NAME=
TZ=Asia/Ho_Chi_Minh

# Ngưỡng cảnh báo (%)
RAM_WARN=85
RAM_CRIT=95
DISK_WARN=85
DISK_CRIT=95
SWAP_WARN=80
CPU_WARN=90
CPU_SUSTAIN_MIN=5
LOAD_WARN_PER_CORE=2

# Bảo mật
SSH_FAIL_PER_IP=10          # số lần SSH sai từ 1 IP trong SSH_WINDOW_MIN phút
SSH_FAIL_TOTAL=50           # tổng số lần SSH sai trong SSH_WINDOW_MIN phút
SSH_WINDOW_MIN=10
SYN_RECV_WARN=100           # nghi SYN flood
CONN_PER_IP_WARN=150        # 1 IP giữ quá nhiều kết nối

# Thông báo
NOTIFY_SSH_LOGIN=true       # báo mỗi lần đăng nhập SSH thành công
NOTIFY_NEW_PORT=true        # báo khi có cổng mới mở ra Internet
NOTIFY_CONTAINER_STOP=true  # báo cả khi container dừng bình thường
ALERT_REPEAT_MIN=120        # nhắc lại cảnh báo chưa xử lý sau N phút (0 = tắt)
